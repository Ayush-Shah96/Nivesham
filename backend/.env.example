# YouTube Intelligence browser transcript extraction
# Uses installed Google Chrome by default. Set to msedge or chromium as needed.
YOUTUBE_BROWSER_CHANNEL=chrome
YOUTUBE_BROWSER_TIMEOUT_SECONDS=120
# Optional: use a specific Chrome/Chromium executable instead of a browser channel.
# YOUTUBE_BROWSER_EXECUTABLE=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe

# YouTube browser session / caption access (optional, but recommended when YouTube verifies requests)
# Best local option: create a dedicated persistent profile, launch it headful once, sign in to YouTube,
# then set YOUTUBE_BROWSER_HEADLESS=true for later runs. Do NOT point this at your everyday Chrome profile.
# YOUTUBE_BROWSER_USER_DATA_DIR=./data/youtube-browser-profile
YOUTUBE_BROWSER_HEADLESS=true
# On the first headed profile run, pause here to let you sign in manually. Set to 0 afterward.
# YOUTUBE_BROWSER_LOGIN_WAIT_SECONDS=120
# Alternative: Netscape-format cookies.txt. Treat this as a password; do not commit/share the file.
# YOUTUBE_COOKIES_FILE=./secrets/youtube-cookies.txt
# Optional proxy. If credentials are included, URL-encode special characters.
# YOUTUBE_BROWSER_PROXY=http://username:password@proxy-host:port
# YOUTUBE_TRANSCRIPT_PROXY_URL=http://username:password@proxy-host:port
YOUTUBE_SUMMARY_CHUNK_CHARS=10500
YOUTUBE_SUMMARY_CHUNK_MAX_TOKENS=1200
YOUTUBE_SUMMARY_MAX_TOKENS=1800
YOUTUBE_OLLAMA_NUM_CTX=16384

# Ops Tracker uses the existing Supabase project/tables (no schema migration).
SUPABASE_URL=https://fzqwjcuxrpdhtqwmjkzu.supabase.co
# Prefer a server-only service role key in production; never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Existing anon key is retained as a compatibility fallback if no service key is configured.
SUPABASE_ANON_KEY=
# Keep this file on persistent storage so manual member/login links survive redeploys.
OPS_TRACKER_LINKS_PATH=./data/ops_tracker_links.json
